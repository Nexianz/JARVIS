# Revoke the key embedded in the original ZIP. Enter a NEW key only in local .env.
# Recommended: keep endpoint and secret separate.
ALCHEMY_ENDPOINT=https://eth-mainnet.g.alchemy.com/v2/{API_KEY}
ALCHEMY_API_KEY=REPLACE_WITH_NEW_KEY

# Alternative: full HTTPS URL; if nonempty, takes precedence over the two fields above.
ETH_RPC_URL=

# Web app: use a random owner password, at least 16 characters. Server-side only.
PAPER_ADMIN_TOKEN=REPLACE_WITH_RANDOM_OWNER_PASSWORD
# Optional: actual language-model decisions; otherwise the dashboard labels the rule-based agent.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
